{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../core-domain/src/**/*.ts",
    "../cli-sim/src/**/*.ts",
  "../design-system/src/**/*.ts",
  "../design-system/src/**/*.tsx",
    "assets/**/*.json",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist"
  ]
}
