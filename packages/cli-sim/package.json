{
  "name": "@lucky-break/cli-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lucky-break": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" --max-warnings=0 --fix --no-error-on-unmatched-pattern",
  "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "simulate:verify": "tsx ../../scripts/ci-simulation.ts"
  },
  "dependencies": {
    "@lucky-break/core-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "4.19.2",
    "typescript": "^5.9.3"
  }
}
